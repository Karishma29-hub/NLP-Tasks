 "cells": [
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "ac547757-88fa-4467-83ee-867ddc1e7bb0",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "in 2.9266\n",
      "during 0.9408\n",
      "near 0.7569\n",
      "nadu 0.6284\n",
      "</s> 0.5753\n"
     ]
    }
   ],
   "source": [
    "from collections import defaultdict\n",
    "\n",
    "DISCOUNT = 0.75\n",
    "\n",
    "class NGramModel:\n",
    "\n",
    "    def __init__(self, n=5):\n",
    "        self.n = n\n",
    "        self.ngrams = [defaultdict(int) for _ in range(n)]\n",
    "        self.contexts = [defaultdict(int) for _ in range(n)]\n",
    "\n",
    "    def train(self, corpus):\n",
    "\n",
    "        for sentence in corpus:\n",
    "\n",
    "            words = [\"<s>\"]*(self.n-1) + sentence.lower().split() + [\"</s>\"]\n",
    "\n",
    "            for k in range(1, self.n+1):\n",
    "\n",
    "                for i in range(len(words)-k+1):\n",
    "\n",
    "                    gram = tuple(words[i:i+k])\n",
    "\n",
    "                    self.ngrams[k-1][gram] += 1\n",
    "\n",
    "                    if k > 1:\n",
    "                        context = gram[:-1]\n",
    "                        self.contexts[k-1][context] += 1\n",
    "\n",
    "    def probability(self, context, word):\n",
    "\n",
    "        return self.kn(context, word)\n",
    "\n",
    "    def kn(self, context, word):\n",
    "\n",
    "        order = len(context) + 1\n",
    "\n",
    "        if order == 1:\n",
    "\n",
    "            total = sum(self.ngrams[0].values())\n",
    "\n",
    "            return self.ngrams[0][(word,)] / total if total else 0\n",
    "\n",
    "        gram = tuple(context + [word])\n",
    "\n",
    "        count = self.ngrams[order-1][gram]\n",
    "\n",
    "        context_count = self.contexts[order-1][tuple(context)]\n",
    "\n",
    "        if context_count == 0:\n",
    "\n",
    "            return self.kn(context[1:], word)\n",
    "\n",
    "        first = max(count - DISCOUNT, 0) / context_count\n",
    "\n",
    "        unique = len([g for g in self.ngrams[order-1] if g[:-1] == tuple(context)])\n",
    "\n",
    "        backoff = (DISCOUNT * unique) / context_count\n",
    "\n",
    "        return first + backoff * self.kn(context[1:], word)\n",
    "\n",
    "    def predict(self, text):\n",
    "\n",
    "        words = text.lower().split()\n",
    "\n",
    "        context = words[-(self.n-1):]\n",
    "\n",
    "        vocab = [g[0] for g in self.ngrams[0]]\n",
    "\n",
    "        scores = {}\n",
    "\n",
    "        for w in vocab:\n",
    "\n",
    "            scores[w] = self.probability(context, w)\n",
    "\n",
    "        scores = sorted(scores.items(), key=lambda x: x[1], reverse=True)\n",
    "\n",
    "        return scores[:5]\n",
    "\n",
    "\n",
    "corpus = [\n",
    "\n",
    "    \"best places to visit in india\",\n",
    "\n",
    "    \"best places to visit in chennai\",\n",
    "\n",
    "    \"best places to visit near me\",\n",
    "\n",
    "    \"best places to visit during summer\",\n",
    "\n",
    "    \"best places to eat in chennai\",\n",
    "\n",
    "    \"places to visit in tamil nadu\"\n",
    "\n",
    "]\n",
    "\n",
    "model = NGramModel(5)\n",
    "\n",
    "model.train(corpus)\n",
    "\n",
    "result = model.predict(\"best places to visit\")\n",
    "\n",
    "for word, prob in result:\n",
    "\n",
    "    print(word, round(prob,4))"
   ]
  },
